# ── LLM Provider ────────────────────────────────────────────────────────────
# Required: used by all four agents (manager, medical_records_manager,
# healthcare_assistant, medical_research_specialist) and the Memory embedder.
OPENAI_API_KEY=your-openai-api-key-here

# ── Web Search ───────────────────────────────────────────────────────────────
# Required for the research_ckd_treatment task (medical_research_specialist
# uses SerperMedicalSearchTool to query WHO, PubMed, Medline, etc.).
# Get a free key at https://serper.dev
SERPER_API_KEY=your-serper-key-here

# ── HuggingFace (RAG embeddings via Inference API — no local model download) ──
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your-huggingface-token-here
HF_TOKEN=your-huggingface-token-here
